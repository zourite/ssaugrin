{
    "name": "ssaugrin",
    "version": "1.2.0",
    "description": "Tailwind integration",
    "main": "index.js",
    "scripts": {
        "start": "concurrently npm:watch:*",
        "watch:vite": "vite",
        "watch:hugo": "hugo server --disableFastRender",
        "build": "vite build && hugo --gc --minify",
        "build:assets": "vite build"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.1.7",
        "concurrently": "^9.0.1",
        "postcss": "^8.5.14",
        "tailwindcss": "^4.1.7",
        "vite": "^6.4.2"
    }
}
